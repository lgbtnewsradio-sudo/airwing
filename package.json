{
  "name": "airwing",
  "version": "1.0.6",
  "description": "Wireless screen mirroring, media streaming and extended desktop for Windows. Mirror to Apple TV (AirPlay), Chromecast (Google Cast), Reflector, and any web browser.",
  "main": "./out/main/index.js",
  "author": "AirWing contributors",
  "license": "GPL-3.0-or-later",
  "private": true,
  "homepage": "https://github.com/lgbtnewsradio-sudo/airwing",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "bplist-creator": "^0.3.0",
    "bplist-parser": "^0.5.0",
    "castv2-client": "^1.2.0",
    "fast-srp-hap": "^2.0.4",
    "mp4-muxer": "^5.2.2",
    "multicast-dns": "^7.2.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@6.11.6": true
  }
}
